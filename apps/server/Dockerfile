# propi-server: Bolt receiver + outbox relay + scheduler (architecture §2.4), and the one-shot migrate.
# Build from the repo root:  docker build -f apps/server/Dockerfile -t propi-server .
# Node 24 runs the TypeScript sources directly, so there is no compile step; Prisma Client is
# generated by packages/db's postinstall.
FROM node:24-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NODE_ENV=production PORT=3001 RUN_MIGRATIONS=false
# openssl: Prisma's schema engine (migrate deploy). ca-certificates: Slack and OpenRouter over TLS.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && apt-get clean
RUN corepack enable
WORKDIR /repo
COPY . .
# Dev dependencies stay installed: the Prisma CLI (migrate deploy) is one.
RUN pnpm install --frozen-lockfile --prod=false --filter "@propi/server..." \
  && chmod +x /repo/apps/server/docker-entrypoint.sh
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
ENTRYPOINT ["/repo/apps/server/docker-entrypoint.sh"]
CMD ["serve"]
