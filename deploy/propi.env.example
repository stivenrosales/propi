# Propi environment for the server, web, migrate and postgres services.
# Copy to /opt/propi/propi.env on the host (or .env for local development) and fill in.
# Never commit real values.

# Postgres connection string. Dev: postgresql://propi:propi@localhost:55433/propi
# Stack: postgresql://propi:<password>@postgres:5432/propi
DATABASE_URL=
# Used by the stack's postgres service to create the database (must match DATABASE_URL).
POSTGRES_USER=propi
POSTGRES_PASSWORD=
POSTGRES_DB=propi

# 32-byte key, hex or base64, that encrypts webhook secrets and installations at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Workspaces install Propi with "Add to Slack" (/slack/install, OAuth v2): each workspace's bot token
# is stored encrypted in its installation, so no bot token is needed here.
# Legacy single-workspace bootstrap (optional): a bot token (xoxb-…) whose team gets its token adopted
# into the installation on start (S4), or a new workspace when SLACK_INSTALLER_USER_ID is also set.
SLACK_BOT_TOKEN=
# Slack app-level token (xapp-…, scope connections:write) for Socket Mode (the default). Without it
# (and without SLACK_SIGNING_SECRET) the server runs health only (/healthz).
SLACK_APP_TOKEN=
# Set to false to receive events over HTTP at /slack/events instead of Socket Mode.
SLACK_SOCKET_MODE=true
# Required only in HTTP mode: Basic Information → Signing Secret.
SLACK_SIGNING_SECRET=
# Legacy: Slack user id (U…) of the installer for SLACK_BOT_TOKEN's team; they become the first admin
# (S5). OAuth installs use the installing user instead.
SLACK_INSTALLER_USER_ID=

# HTTP port of apps/server: /healthz (and /slack/events in HTTP mode).
PORT=3001
# Public URL of the web app, linked from the App Home and weekly reports; the web app's own base URL.
APP_URL=https://propihq.com

# Web app: signs session cookies and TV display tokens, at least 32 characters.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Web app: Sign in with Slack (OpenID Connect) and Add to Slack (OAuth v2), Basic Information → App
# Credentials. Redirect URLs: ${APP_URL}/auth/slack/callback and ${APP_URL}/slack/oauth/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Fallback IANA timezone for a new workspace when the installer's Slack profile has none (S2).
PROPI_TIMEZONE=America/Lima
# Set to false to disable the minute scheduler on this replica.
PROPI_SCHEDULER=true
# How often the outbox relay polls for new events, in ms.
PROPI_RELAY_INTERVAL_MS=2000

# Optional: the monthly AI digest (S91). Without a key the digest is skipped and logged.
OPENROUTER_API_KEY=
# OpenRouter model id for the digest.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional product analytics. PostHog project API key (phc_...); empty disables it.
POSTHOG_KEY=

# Optional: billing through Polar (S6, S7). Billing is on only when the first three are set; without
# them there is no plan limit and the billing page says billing is not configured.
# Token scopes: checkouts:write, customer_sessions:write. Webhook: ${APP_URL}/api/polar/webhook, Raw
# format, events subscription.created/updated/active/canceled/uncanceled/revoked/past_due.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# The seat-priced "Propi Pro" product id.
POLAR_PRO_PRODUCT_ID=
# sandbox (default) or production.
POLAR_SERVER=sandbox
