# Propi environment for the server, web, migrate and postgres services.
# Copy to /opt/propi/propi.env on the host (or .env for local development) and fill in.
# Never commit real values.

# Postgres connection string. Dev: postgresql://propi:propi@localhost:55433/propi
# Stack: postgresql://propi:<password>@postgres:5432/propi
DATABASE_URL=
# Used by the stack's postgres service to create the database (must match DATABASE_URL).
POSTGRES_USER=propi
POSTGRES_PASSWORD=
POSTGRES_DB=propi

# 32-byte key, hex or base64, that encrypts webhook secrets and installations at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Slack bot token (xoxb-…): OAuth & Permissions → Install to workspace. Optional until the Slack app
# exists: without it the server runs health only (/healthz) and logs "Slack not configured".
SLACK_BOT_TOKEN=
# Slack app-level token (xapp-…, scope connections:write) for Socket Mode (the default). Required
# once SLACK_BOT_TOKEN is set.
SLACK_APP_TOKEN=
# Set to false to receive events over HTTP at /slack/events instead of Socket Mode.
SLACK_SOCKET_MODE=true
# Required only in HTTP mode: Basic Information → Signing Secret.
SLACK_SIGNING_SECRET=
# Slack user id (U…) of the person who installed the app; they become the first admin (S5).
# Needed on the first start for a Slack team; ignored afterwards.
SLACK_INSTALLER_USER_ID=

# HTTP port of apps/server: /healthz (and /slack/events in HTTP mode).
PORT=3001
# Public URL of the web app, linked from the App Home and weekly reports; the web app's own base URL.
APP_URL=https://propihq.com

# Web app: signs session cookies and TV display tokens, at least 32 characters.
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Web app: Sign in with Slack (OpenID Connect), Basic Information → App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# IANA timezone for a newly installed workspace (S3), e.g. America/Lima.
PROPI_TIMEZONE=America/Lima
# Set to false to disable the minute scheduler on this replica.
PROPI_SCHEDULER=true
# How often the outbox relay polls for new events, in ms.
PROPI_RELAY_INTERVAL_MS=2000

# Optional: the monthly AI digest (S91). Without a key the digest is skipped and logged.
OPENROUTER_API_KEY=
# OpenRouter model id for the digest.
OPENROUTER_MODEL=openai/gpt-4o-mini
