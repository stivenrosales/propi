// Propi Postgres schema (architecture §1.4, §6, §8).
// The migrations in prisma/migrations are hand-written SQL and are the source of truth:
// they add what Prisma cannot model (append-only triggers, per-kind sign CHECKs generated
// from core EFFECTS, identity columns, partial indexes). This file mirrors the tables so
// Prisma Client can be generated; later modules add tables additively.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id
  settings  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members     Member[]
  values      Value[]
  gifts       Gift[]
  commandLogs CommandLog[]

  @@map("workspace")
}

model Member {
  workspaceId        String   @map("workspace_id")
  id                 String
  role               String
  active             Boolean  @default(true)
  dailyLimitOverride Int?     @map("daily_limit_override")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  identities Identity[]
  entries    LedgerEntry[]

  @@id([workspaceId, id])
  @@map("member")
}

/// S107: one member, many platform identities.
model Identity {
  workspaceId    String  @map("workspace_id")
  platform       String
  platformTeamId String  @map("platform_team_id")
  platformUserId String  @map("platform_user_id")
  memberId       String  @map("member_id")
  email          String?

  member Member @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, platform, platformTeamId, platformUserId])
  @@index([workspaceId, memberId], map: "identity_member_idx")
  @@map("identity")
}

/// S41: company values. Position keeps definition order.
model Value {
  workspaceId String  @map("workspace_id")
  id          String
  name        String
  hashtag     String?
  emoji       String?
  position    Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("value")
}

/// Gift header: one row per gift. Text is rewritten on edit (S23).
model Gift {
  workspaceId  String    @map("workspace_id")
  id           String
  seq          BigInt    @default(autoincrement())
  giverId      String    @map("giver_id")
  messageRef   String?   @map("message_ref")
  source       String
  emoji        String?
  channelId    String    @map("channel_id")
  isPrivate    Boolean   @map("is_private")
  text         String?
  allowanceDay DateTime? @map("allowance_day") @db.Date
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  closedBy     String?   @map("closed_by")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  values    GiftValue[]

  @@id([workspaceId, id])
  @@index([workspaceId, messageRef, source], map: "gift_message_idx")
  @@map("gift")
}

model GiftValue {
  workspaceId String @map("workspace_id")
  giftId      String @map("gift_id")
  valueId     String @map("value_id")
  ordinal     Int

  gift Gift @relation(fields: [workspaceId, giftId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, giftId, valueId])
  @@map("gift_value")
}

/// G2, S17, S40: one row per command key. Append-only except the single running -> done step.
model CommandLog {
  workspaceId String    @map("workspace_id")
  key         String
  seq         BigInt    @default(autoincrement())
  requestHash String    @map("request_hash")
  status      String
  commandType String?   @map("command_type")
  actor       Json?
  command     Json?
  result      Json?
  at          DateTime? @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries   LedgerEntry[]
  events    DomainEvent[]

  @@id([workspaceId, key])
  @@index([workspaceId, seq], map: "command_log_seq_idx")
  @@map("command_log")
}

/// S30: append-only money movements. The sign of amount is fixed by kind (G1 CHECK).
model LedgerEntry {
  seq           BigInt    @id @default(autoincrement())
  workspaceId   String    @map("workspace_id")
  commandKey    String    @map("command_key")
  ordinal       Int
  kind          String
  amount        Int
  memberId      String    @map("member_id")
  counterpartId String?   @map("counterpart_id")
  causeType     String    @map("cause_type")
  causeId       String?   @map("cause_id")
  cause         Json
  source        String?
  allowanceDay  DateTime? @map("allowance_day") @db.Date
  at            DateTime  @db.Timestamptz(3)
  reason        String?

  commandLog CommandLog @relation(fields: [workspaceId, commandKey], references: [workspaceId, key], onDelete: NoAction, onUpdate: NoAction)
  member     Member     @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, commandKey, ordinal], map: "ledger_entry_command_ordinal_key")
  @@index([workspaceId, memberId], map: "ledger_entry_member_idx")
  @@index([workspaceId, counterpartId, allowanceDay], map: "ledger_entry_allowance_idx")
  @@index([workspaceId, at], map: "ledger_entry_at_idx")
  @@index([workspaceId, causeType, causeId], map: "ledger_entry_cause_idx")
  @@map("ledger_entry")
}

/// Outbox (§6). Append-only; delivery state lives in `delivery`.
model DomainEvent {
  id          String   @id
  seq         BigInt   @default(autoincrement())
  workspaceId String   @map("workspace_id")
  commandKey  String   @map("command_key")
  ordinal     Int
  type        String
  payload     Json
  at          DateTime @db.Timestamptz(3)

  commandLog CommandLog @relation(fields: [workspaceId, commandKey], references: [workspaceId, key], onDelete: NoAction, onUpdate: NoAction)
  deliveries Delivery[]

  @@unique([workspaceId, commandKey, ordinal], map: "domain_event_command_ordinal_key")
  @@index([workspaceId, seq], map: "domain_event_seq_idx")
  @@map("domain_event")
}

model Delivery {
  id            String   @id
  eventId       String   @map("event_id")
  destination   String
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?  @map("last_error")

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([eventId, destination], map: "delivery_event_destination_key")
  @@map("delivery")
}
