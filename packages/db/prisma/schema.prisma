// Propi Postgres schema (architecture §1.4, §6, §8).
// The migrations in prisma/migrations are hand-written SQL and are the source of truth:
// they add what Prisma cannot model (append-only triggers, per-kind sign CHECKs generated
// from core EFFECTS, identity columns, partial indexes). This file mirrors the tables so
// Prisma Client can be generated; later modules add tables additively.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id
  settings  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members     Member[]
  values      Value[]
  gifts       Gift[]
  commandLogs CommandLog[]

  moduleConfigs     ModuleConfig[]
  rewards           Reward[]
  redemptions       Redemption[]
  collabs           Collab[]
  awardRules        AwardRule[]
  quests            Quest[]
  questSubmissions  QuestSubmission[]
  questComments     QuestComment[]
  stickers          Sticker[]
  stickerGrants     StickerGrant[]
  stickerUses       StickerUse[]
  memberAvatars     MemberAvatar[]
  milestoneProfiles MilestoneProfile[]
  pairingOptIns     PairingOptIn[]
  pairingRounds     PairingRound[]

  apiTokens        ApiToken[]
  webhookEndpoints WebhookEndpoint[]
  deliveries       Delivery[]
  installations    Installation[]

  @@map("workspace")
}

model Member {
  workspaceId        String   @map("workspace_id")
  id                 String
  role               String
  active             Boolean  @default(true)
  dailyLimitOverride Int?     @map("daily_limit_override")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  identities  Identity[]
  entries     LedgerEntry[]
  preferences NotificationPreference[]

  @@id([workspaceId, id])
  @@map("member")
}

/// S107: one member, many platform identities.
model Identity {
  workspaceId    String  @map("workspace_id")
  platform       String
  platformTeamId String  @map("platform_team_id")
  platformUserId String  @map("platform_user_id")
  memberId       String  @map("member_id")
  email          String?

  member Member @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, platform, platformTeamId, platformUserId])
  @@index([workspaceId, memberId], map: "identity_member_idx")
  @@map("identity")
}

/// S41: company values. Position keeps definition order.
model Value {
  workspaceId String  @map("workspace_id")
  id          String
  name        String
  hashtag     String?
  emoji       String?
  position    Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("value")
}

/// Gift header: one row per gift. Text is rewritten on edit (S23).
model Gift {
  workspaceId  String    @map("workspace_id")
  id           String
  seq          BigInt    @default(autoincrement())
  giverId      String    @map("giver_id")
  messageRef   String?   @map("message_ref")
  source       String
  emoji        String?
  channelId    String    @map("channel_id")
  isPrivate    Boolean   @map("is_private")
  text         String?
  allowanceDay DateTime? @map("allowance_day") @db.Date
  createdAt    DateTime  @map("created_at") @db.Timestamptz(3)
  closedBy     String?   @map("closed_by")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  values    GiftValue[]

  @@id([workspaceId, id])
  @@index([workspaceId, messageRef, source], map: "gift_message_idx")
  @@map("gift")
}

model GiftValue {
  workspaceId String @map("workspace_id")
  giftId      String @map("gift_id")
  valueId     String @map("value_id")
  ordinal     Int

  gift Gift @relation(fields: [workspaceId, giftId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, giftId, valueId])
  @@map("gift_value")
}

/// G2, S17, S40: one row per command key. Append-only except the single running -> done step.
model CommandLog {
  workspaceId String    @map("workspace_id")
  key         String
  seq         BigInt    @default(autoincrement())
  requestHash String    @map("request_hash")
  status      String
  commandType String?   @map("command_type")
  actor       Json?
  command     Json?
  result      Json?
  at          DateTime? @db.Timestamptz(3)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries   LedgerEntry[]
  events    DomainEvent[]

  @@id([workspaceId, key])
  @@index([workspaceId, seq], map: "command_log_seq_idx")
  @@map("command_log")
}

/// S30: append-only money movements. The sign of amount is fixed by kind (G1 CHECK).
model LedgerEntry {
  seq           BigInt    @id @default(autoincrement())
  workspaceId   String    @map("workspace_id")
  commandKey    String    @map("command_key")
  ordinal       Int
  kind          String
  amount        Int
  memberId      String    @map("member_id")
  counterpartId String?   @map("counterpart_id")
  causeType     String    @map("cause_type")
  causeId       String?   @map("cause_id")
  cause         Json
  source        String?
  allowanceDay  DateTime? @map("allowance_day") @db.Date
  at            DateTime  @db.Timestamptz(3)
  reason        String?

  commandLog CommandLog @relation(fields: [workspaceId, commandKey], references: [workspaceId, key], onDelete: NoAction, onUpdate: NoAction)
  member     Member     @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, commandKey, ordinal], map: "ledger_entry_command_ordinal_key")
  @@index([workspaceId, memberId], map: "ledger_entry_member_idx")
  @@index([workspaceId, counterpartId, allowanceDay], map: "ledger_entry_allowance_idx")
  @@index([workspaceId, at], map: "ledger_entry_at_idx")
  @@index([workspaceId, causeType, causeId], map: "ledger_entry_cause_idx")
  @@map("ledger_entry")
}

/// Outbox (§6). Append-only; delivery state lives in `delivery`.
model DomainEvent {
  id          String   @id
  seq         BigInt   @default(autoincrement())
  workspaceId String   @map("workspace_id")
  commandKey  String   @map("command_key")
  ordinal     Int
  type        String
  payload     Json
  at          DateTime @db.Timestamptz(3)
  /// Generated: propi_webhook_event_id(workspace_id, command_key, ordinal), the S99 event id.
  publicId    String?  @unique(map: "domain_event_public_id_key") @map("public_id")

  commandLog CommandLog      @relation(fields: [workspaceId, commandKey], references: [workspaceId, key], onDelete: NoAction, onUpdate: NoAction)
  deliveries Delivery[]
  receipts   OutboxReceipt[]

  @@unique([workspaceId, commandKey, ordinal], map: "domain_event_command_ordinal_key")
  @@index([workspaceId, seq], map: "domain_event_seq_idx")
  @@map("domain_event")
}

model Delivery {
  id            String   @id
  seq           BigInt   @default(autoincrement())
  workspaceId   String   @map("workspace_id")
  eventId       String   @map("event_id")
  destination   String
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?  @map("last_error")

  event     DomainEvent @relation(fields: [eventId], references: [publicId], onDelete: NoAction, onUpdate: NoAction)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([eventId, destination], map: "delivery_event_destination_key")
  @@index([workspaceId, seq], map: "delivery_workspace_idx")
  @@map("delivery")
}

// ───────────── Module state (migration 20261125020000_modules) ─────────────

/// Per-module configuration: shop, stickers, levels, milestones, pairing.
model ModuleConfig {
  workspaceId String @map("workspace_id")
  module      String
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, module])
  @@map("module_config")
}

/// S44-S46. stock NULL = unlimited, never below 0 (CHECK).
model Reward {
  workspaceId String   @map("workspace_id")
  id          String
  seq         BigInt   @default(autoincrement())
  status      String
  stock       Int?
  data        Json
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variants  RewardVariant[]

  @@id([workspaceId, id])
  @@map("reward")
}

model RewardVariant {
  workspaceId String @map("workspace_id")
  rewardId    String @map("reward_id")
  id          String
  name        String
  stock       Int?
  position    Int

  reward Reward @relation(fields: [workspaceId, rewardId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, rewardId, id])
  @@map("reward_variant")
}

/// S49-S55, S108. state is compare-and-set by the adapter.
model Redemption {
  workspaceId String  @map("workspace_id")
  id          String
  seq         BigInt  @default(autoincrement())
  state       String
  memberId    String? @map("member_id")
  rewardId    String? @map("reward_id")
  collabId    String? @map("collab_id")
  budgetMonth String? @map("budget_month")
  giftCard    Boolean @map("gift_card")
  cardIssued  Boolean @map("card_issued")
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@index([workspaceId, budgetMonth], map: "redemption_budget_idx")
  @@map("redemption")
}

/// S56-S59. phase is compare-and-set by the adapter.
model Collab {
  workspaceId String @map("workspace_id")
  id          String
  seq         BigInt @default(autoincrement())
  phase       String
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("collab")
}

/// S60-S63.
model AwardRule {
  workspaceId String @map("workspace_id")
  id          String
  seq         BigInt @default(autoincrement())
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("award_rule")
}

/// S64-S68.
model Quest {
  workspaceId String @map("workspace_id")
  id          String
  seq         BigInt @default(autoincrement())
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("quest")
}

model QuestSubmission {
  workspaceId String @map("workspace_id")
  id          String
  seq         BigInt @default(autoincrement())
  questId     String @map("quest_id")
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@index([workspaceId, questId, seq], map: "quest_submission_quest_idx")
  @@map("quest_submission")
}

model QuestComment {
  seq          BigInt @id @default(autoincrement())
  workspaceId  String @map("workspace_id")
  submissionId String @map("submission_id")
  data         Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, submissionId, seq], map: "quest_comment_submission_idx")
  @@map("quest_comment")
}

/// S73-S76.
model Sticker {
  workspaceId String @map("workspace_id")
  id          String
  seq         BigInt @default(autoincrement())
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("sticker")
}

model StickerGrant {
  seq         BigInt @id @default(autoincrement())
  workspaceId String @map("workspace_id")
  memberId    String @map("member_id")
  stickerId   String @map("sticker_id")
  month       String
  uses        Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, memberId, stickerId, month], map: "sticker_grant_idx")
  @@map("sticker_grant")
}

model StickerUse {
  seq         BigInt @id @default(autoincrement())
  workspaceId String @map("workspace_id")
  giftId      String @map("gift_id")
  stickerId   String @map("sticker_id")
  giverId     String @map("giver_id")
  month       String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, giverId, stickerId, month], map: "sticker_use_idx")
  @@map("sticker_use")
}

/// S78.
model MemberAvatar {
  workspaceId String @map("workspace_id")
  memberId    String @map("member_id")
  avatarId    String @map("avatar_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, memberId])
  @@map("member_avatar")
}

/// S92-S94.
model MilestoneProfile {
  workspaceId String @map("workspace_id")
  memberId    String @map("member_id")
  seq         BigInt @default(autoincrement())
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, memberId])
  @@map("milestone_profile")
}

/// S95-S96.
model PairingOptIn {
  workspaceId String  @map("workspace_id")
  memberId    String  @map("member_id")
  optedIn     Boolean @map("opted_in")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, memberId])
  @@map("pairing_optin")
}

model PairingRound {
  seq         BigInt @id @default(autoincrement())
  workspaceId String @map("workspace_id")
  round       String
  data        Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, seq], map: "pairing_round_idx")
  @@map("pairing_round")
}

// ───────────── API, webhooks, insights, installs (migration 20261125030000) ─────────────

/// S98: the plaintext token is never stored; secret_hash is its SHA-256 hex.
model ApiToken {
  id          String    @id
  workspaceId String    @map("workspace_id")
  seq         BigInt    @default(autoincrement())
  name        String
  scopes      String[]
  secretHash  String    @map("secret_hash")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy   Json      @map("created_by")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, seq], map: "api_token_workspace_idx")
  @@map("api_token")
}

/// S99: secret_enc is AES-256-GCM ciphertext under ENCRYPTION_KEY.
model WebhookEndpoint {
  workspaceId String  @map("workspace_id")
  id          String
  seq         BigInt  @default(autoincrement())
  url         String
  secretEnc   String  @map("secret_enc")
  events      Json
  active      Boolean @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, id])
  @@map("webhook_endpoint")
}

/// One receipt per outbox consumer and event (claimed with FOR NO KEY UPDATE SKIP LOCKED).
model OutboxReceipt {
  consumer  String
  eventId   String   @map("event_id")
  handledAt DateTime @default(now()) @map("handled_at") @db.Timestamptz(3)

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([consumer, eventId])
  @@map("outbox_receipt")
}

/// S85: per-member notification switches.
model NotificationPreference {
  workspaceId String @map("workspace_id")
  memberId    String @map("member_id")
  seq         BigInt @default(autoincrement())
  prefs       Json

  member Member @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, memberId])
  @@map("notification_preference")
}

/// S5, S72: one row per platform tenant; data_enc is the encrypted installation (bot token).
model Installation {
  platform      String
  tenantId      String    @map("tenant_id")
  workspaceId   String    @map("workspace_id")
  dataEnc       String?   @map("data_enc")
  installedAt   DateTime  @map("installed_at") @db.Timestamptz(3)
  uninstalledAt DateTime? @map("uninstalled_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([platform, tenantId])
  @@index([workspaceId], map: "installation_workspace_idx")
  @@map("installation")
}
