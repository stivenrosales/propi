  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@propi/app": "workspace:*",
    "@propi/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
